# --- Secrets / env (keep only *.example tracked) ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# --- Backend (Go) ---
backend/tmp/
backend/bin/
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/docs/*.json
backend/docs/*.yaml
backend/coverage.out
backend/*.exe
backend/*.test

# --- Frontend (Nuxt) ---
frontend/node_modules/
frontend/.nuxt/
frontend/.output/
frontend/.data/
frontend/.nitro/
frontend/.cache/
frontend/dist/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.pem
*.log
