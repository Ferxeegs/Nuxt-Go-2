# syntax=docker/dockerfile:1.7
# Official images via AWS Public ECR (Docker Hub timeouts are common).
FROM public.ecr.aws/docker/library/node:22-alpine
# Do not use WORKDIR /app: Nuxt 3.16+ treats "app" as the application dir
# and Vite then serves /_nuxt/app/node_modules/... which breaks #build aliases.
WORKDIR /frontend

RUN apk add --no-cache wget

# Only the manifests: source is bind-mounted by docker-compose, so copying it
# here would just bust the layer cache. Scripts skipped (nuxt prepare needs the
# source and `nuxt dev` runs it on start anyway).
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts --no-audit --no-fund

ENV HOST=0.0.0.0
ENV NITRO_HOST=0.0.0.0
ENV NITRO_PORT=3000
ENV NUXT_TELEMETRY_DISABLED=1

EXPOSE 3000 24678
CMD ["npx", "nuxt", "dev", "--host", "0.0.0.0", "--port", "3000"]
