# Copy to `.env` in this directory and fill in real values:
#   cp .env.example .env
#
# Docker Compose injects this file into every service. It also overrides
# API_URL at runtime to the internal service name (http://api-dev:8080 or
# http://api:8080), so the value below is only a host-run fallback.

# ---------- App ----------
APP_ENV=development
APP_PORT=8080

# ---------- Database (shared MySQL container - see docker-compose.yml) ----------
DB_HOST=shared-mysql
DB_PORT=3306
DB_USER=go_cp_user
DB_PASSWORD=change-me
# Must be unique per project - the MySQL instance is shared across projects.
DB_NAME=go_cp_boilerplate

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Run idempotent database seeder on API startup (roles, permissions, SuperAdmin,
# web settings). Default: true when APP_ENV=development, false in production.
# Set DB_SEED=true once on first production deploy if the database is empty.
DB_SEED=false

# ---------- Redis (shared Redis container - see docker-compose.yml) ----------
REDIS_HOST=shared-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Must be unique per project so rate-limit/blacklist keys don't collide with
# other projects on the same shared Redis.
REDIS_PREFIX=cp_projectname_

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12

# Seeded once on first run - change the password after first login.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-please
# Applied when an admin resets a user's password from the Users page (min 6 chars).
DEFAULT_PASSWORD=change-me-please

# Cloudflare Turnstile (login bot protection).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public (browser); secret key stays server-only.
# Production requires TURNSTILE_SECRET_KEY. For local/dev testing use Cloudflare's
# always-pass dummy keys below, or leave both empty to skip verification in non-prod.
# Dummy (always passes):
#   NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- CORS ----------
# Browser origin that nginx serves. Same-origin in Docker (nginx proxies
# the Nuxt app, /api/, and /uploads/). Examples:
#   local:  http://localhost
#   prod:   https://ponpes.ferxcode.my.id
ALLOWED_ORIGINS=http://localhost

# ---------- Rate limiting ----------
RATE_LIMIT_PUBLIC_PER_MINUTE=100
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ---------- Upload ----------
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./storage/uploads

# ---------- MinIO / S3 ----------
# Host-mapped ports for the MinIO API + web console.
MINIO_API_PORT=9020
MINIO_CONSOLE_PORT=9021
MINIO_ROOT_USER=minioadmin
# MinIO requires passwords >= 8 characters. Keep this identical for the
# MinIO server and the init job (and S3_SECRET_KEY below).
MINIO_ROOT_PASSWORD=change-me-minio-pass
MINIO_SITE_REGION=us-east-1
MINIO_DEFAULT_BUCKET=template-documents
MINIO_PUBLIC_BUCKET=template-public-documents

# Go API / clients inside Docker must use the underscore-free network alias
# (template-minio-svc). Do NOT use container_name "template_minio" as host.
S3_ENDPOINT_URL=http://template-minio-svc:9000
# Browser / host-side URL for public objects.
# Prefer same-origin nginx proxy "/storage" (see deploy/nginx/*.conf).
# Direct MinIO path-style alternative: http://localhost:9020/template-public-documents
S3_PUBLIC_ENDPOINT_URL=/storage
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-pass
S3_REGION=us-east-1
S3_BUCKET=template-documents
S3_PUBLIC_BUCKET=template-public-documents
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true

# ---------- Logging ----------
LOG_LEVEL=info

# ---------- Email (optional - contact form notifications / forgot password) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
NOTIFY_EMAIL=admin@example.com

# ---------- Frontend (Nuxt runtimeConfig) ----------
# Server-only Go API origin (Nitro / server routes). Compose overrides this
# to http://api-dev:8080 or http://api:8080.
API_URL=http://localhost:8080

# Public API origin the browser uses. Empty or same-origin is preferred
# because nginx proxies /api/ to Go. Examples:
#   local (nginx :80):  http://localhost
#   local prod nginx:   http://localhost:8080
#   prod:               https://ponpes.ferxcode.my.id
NUXT_PUBLIC_API_URL=http://localhost

# This site's public URL (canonical links, sitemap, robots).
NUXT_PUBLIC_SITE_URL=http://localhost

# Auth cookie Secure flag (access_token / refresh_token).
# false on HTTP (local). true only when the site is served over HTTPS.
# Note: tokens are not HttpOnly — SPA must read them for Authorization: Bearer.
NUXT_PUBLIC_COOKIE_SECURE=false
